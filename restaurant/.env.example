# Copia este archivo como ".env" en la raíz del módulo "restaurant"
# (junto al pom.xml) y rellena los valores reales.
# NUNCA subas el archivo ".env" real al repositorio.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/restaurant
SPRING_DATASOURCE_NAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SERVER_PORT=8080
